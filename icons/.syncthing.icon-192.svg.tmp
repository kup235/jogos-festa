<svg xmlns="http://www.w3.org/2000/svg" width="192" height="192" viewBox="0 0 192 192">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#12082a"/>
      <stop offset="40%" stop-color="#1a0f3c"/>
      <stop offset="70%" stop-color="#150b30"/>
      <stop offset="100%" stop-color="#0a0618"/>
    </linearGradient>
    <radialGradient id="g1" cx="25%" cy="30%" r="55%">
      <stop offset="0%" stop-color="rgba(139,92,246,0.25)"/>
      <stop offset="100%" stop-color="transparent"/>
    </radialGradient>
    <radialGradient id="g2" cx="75%" cy="70%" r="50%">
      <stop offset="0%" stop-color="rgba(239,68,68,0.15)"/>
      <stop offset="100%" stop-color="transparent"/>
    </radialGradient>
    <linearGradient id="circ" x1="0.3" y1="0.2" x2="0.7" y2="0.65">
      <stop offset="0%" stop-color="#7c3aed"/>
      <stop offset="50%" stop-color="#6d28d9"/>
      <stop offset="100%" stop-color="#5b21b6"/>
    </linearGradient>
    <linearGradient id="gold" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#f9d423"/>
      <stop offset="50%" stop-color="#f59e0b"/>
      <stop offset="100%" stop-color="#f9d423"/>
    </linearGradient>
    <filter id="shadow">
      <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="rgba(0,0,0,0.5)"/>
    </filter>
    <filter id="tshadow">
      <feDropShadow dx="0" dy="1" stdDeviation="2" flood-color="rgba(0,0,0,0.6)"/>
    </filter>
  </defs>
  <rect width="192" height="192" fill="url(#bg)"/>
  <rect width="192" height="192" fill="url(#g1)"/>
  <rect width="192" height="192" fill="url(#g2)"/>
  <circle cx="96" cy="83" r="65" fill="rgba(139,92,246,0.2)"/>
  <circle cx="96" cy="83" r="50" fill="url(#circ)"/>
  <ellipse cx="88" cy="70" rx="35" ry="25" fill="rgba(255,255,255,0.08)"/>
  <text x="96" y="90" text-anchor="middle" dominant-baseline="central" font-size="54" filter="url(#shadow)">🎮</text>
  <text x="96" y="145" text-anchor="middle" font-family="Segoe UI,SF Pro Display,Arial,sans-serif" font-size="21" font-weight="900" fill="url(#gold)" filter="url(#tshadow)">JOGOS</text>
  <text x="96" y="166" text-anchor="middle" font-family="Segoe UI,SF Pro Display,Arial,sans-serif" font-size="11" font-weight="600" fill="rgba(255,255,255,0.5)">DE FESTA</text>
  <circle cx="29" cy="29" r="3" fill="rgba(245,158,11,0.4)"/>
  <circle cx="163" cy="38" r="2.3" fill="rgba(139,92,246,0.5)"/>
  <circle cx="19" cy="144" r="2" fill="rgba(239,68,68,0.4)"/>
  <circle cx="169" cy="154" r="3.5" fill="rgba(245,158,11,0.3)"/>
  <rect x="1" y="1" width="190" height="190" fill="none" stroke="rgba(139,92,246,0.15)" stroke-width="1"/>
</svg>

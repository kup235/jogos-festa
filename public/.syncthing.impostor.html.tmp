<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#0a0a1a">
    <title>Impostor</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        :root {
            --bg: #0a0a1a;
            --card: rgba(255,255,255,0.06);
            --border: rgba(255,255,255,0.08);
            --text: #fff;
            --dim: #8888aa;
            --accent: #ef4444;
            --accent2: #fca5a5;
            --green: #22c55e;
            --red: #ef4444;
            --gold: #f59e0b;
            --purple: #8b5cf6;
        }

        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100dvh;
            overflow-x: hidden;
        }

        .bg-glow {
            position: fixed;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: radial-gradient(circle at 30% 40%, rgba(239,68,68,0.1) 0%, transparent 50%),
                        radial-gradient(circle at 70% 70%, rgba(245,158,11,0.06) 0%, transparent 50%);
            animation: bgFloat 20s ease-in-out infinite;
            z-index: 0;
            pointer-events: none;
        }
        @keyframes bgFloat {
            0%, 100% { transform: translate(0, 0); }
            33% { transform: translate(20px, -20px); }
            66% { transform: translate(-15px, 15px); }
        }

        .app {
            position: relative;
            z-index: 1;
            max-width: 420px;
            margin: 0 auto;
            padding: 20px;
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
        }

        .top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0;
            margin-bottom: 8px;
        }
        .top-bar .back {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            color: var(--text);
            font-size: 18px;
            width: 40px; height: 40px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
            text-decoration: none;
        }
        .top-bar h1 {
            font-size: 18px;
            font-weight: 800;
            background: linear-gradient(135deg, #ef4444, #f97316);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .room-code {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 6px 12px;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            color: var(--accent2);
        }

        .screen { display: none; flex-direction: column; flex: 1; }
        .screen.active { display: flex; }

        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 12px;
        }

        .btn {
            display: block;
            width: 100%;
            padding: 16px;
            border: none;
            border-radius: 16px;
            font-family: inherit;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.1s, opacity 0.1s;
            text-align: center;
            text-decoration: none;
            color: #fff;
        }
        .btn:active { transform: scale(0.97); }
        .btn:disabled { opacity: 0.4; cursor: default; transform: none; }
        .btn-primary { background: linear-gradient(135deg, #dc2626, #ef4444); }
        .btn-green { background: linear-gradient(135deg, #059669, #22c55e); }
        .btn-purple { background: linear-gradient(135deg, #7c3aed, #8b5cf6); }
        .btn-ghost { background: var(--card); border: 1px solid var(--border); color: var(--dim); }

        .input-group { margin-bottom: 16px; }
        .input-group label {
            display: block; font-size: 13px; font-weight: 600;
            color: var(--dim); margin-bottom: 6px;
            text-transform: uppercase; letter-spacing: 0.5px;
        }
        .input-group input {
            width: 100%; padding: 14px 16px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border); border-radius: 14px;
            color: var(--text); font-family: inherit; font-size: 16px;
            outline: none; transition: border-color 0.2s;
        }
        .input-group input:focus { border-color: var(--accent); }
        .input-group input::placeholder { color: rgba(255,255,255,0.2); }

        .players-list { list-style: none; padding: 0; }
        .players-list li {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 0; border-bottom: 1px solid var(--border);
            font-size: 15px;
        }
        .players-list li:last-child { border-bottom: none; }
        .players-list .avatar {
            width: 36px; height: 36px; border-radius: 50%;
            background: linear-gradient(135deg, #ef4444, #f97316);
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; font-weight: 800;
        }
        .players-list .name { flex: 1; }
        .players-list .host-badge {
            font-size: 11px; background: rgba(245,158,11,0.2);
            color: var(--gold); padding: 2px 8px; border-radius: 8px; font-weight: 600;
        }

        .timer-bar {
            height: 4px; background: rgba(255,255,255,0.1);
            border-radius: 4px; margin-bottom: 16px; overflow: hidden;
        }
        .timer-bar .fill {
            height: 100%; background: linear-gradient(90deg, var(--accent), var(--gold));
            border-radius: 4px; transition: width 1s linear;
        }

        .big-word { text-align: center; padding: 24px 16px; }
        .big-word .label {
            font-size: 13px; text-transform: uppercase;
            letter-spacing: 1px; color: var(--dim); margin-bottom: 8px;
        }
        .big-word .word {
            font-size: 42px; font-weight: 900;
            background: linear-gradient(135deg, #f9d423, #ff4e50);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        /* Role reveal animation */
        .role-reveal {
            text-align: center;
            padding: 32px 16px;
        }
        .role-reveal .role-icon {
            font-size: 80px;
            animation: roleAppear 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }
        @keyframes roleAppear {
            0% { transform: scale(0) rotate(-180deg); opacity: 0; }
            60% { transform: scale(1.2) rotate(10deg); }
            100% { transform: scale(1) rotate(0); opacity: 1; }
        }
        .role-reveal h2 {
            font-size: 28px; font-weight: 900; margin-top: 16px;
        }
        .role-reveal h2.impostor-text {
            background: linear-gradient(135deg, #ef4444, #f97316);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .role-reveal h2.citizen-text {
            background: linear-gradient(135deg, #22c55e, #10b981);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .role-reveal .category {
            margin-top: 8px; font-size: 14px; color: var(--dim);
        }
        .role-reveal .secret-word {
            margin-top: 16px; font-size: 36px; font-weight: 900;
            color: var(--gold);
        }
        .role-reveal .secret-hidden {
            margin-top: 16px; font-size: 36px; font-weight: 900;
            color: var(--red);
        }

        /* Vote cards */
        .vote-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .vote-btn {
            background: var(--card);
            border: 2px solid var(--border);
            border-radius: 16px;
            padding: 16px;
            text-align: center;
            cursor: pointer;
            transition: all 0.15s;
            color: var(--text);
            font-family: inherit;
        }
        .vote-btn:active { transform: scale(0.95); }
        .vote-btn.selected {
            border-color: var(--accent);
            background: rgba(239,68,68,0.15);
        }
        .vote-btn .vote-avatar {
            width: 48px; height: 48px; border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; font-weight: 800; margin: 0 auto 8px;
        }
        .vote-btn .vote-name { font-size: 14px; font-weight: 700; }
        .vote-btn .vote-count {
            font-size: 12px; color: var(--dim); margin-top: 4px;
        }

        .result-display { text-align: center; padding: 24px 0; }
        .result-display .emoji {
            font-size: 64px; margin-bottom: 12px;
            animation: resultBounce 0.5s ease;
        }
        @keyframes resultBounce {
            0% { transform: scale(0); }
            50% { transform: scale(1.3); }
            100% { transform: scale(1); }
        }
        .result-display .msg { font-size: 22px; font-weight: 800; }

        .round-info {
            text-align: center; font-size: 13px; color: var(--dim); margin-bottom: 16px;
        }
        .round-info strong { color: var(--accent2); }

        .waiting { text-align: center; padding: 24px; color: var(--dim); }
        .waiting .dots::after { content: ''; animation: dots 1.5s steps(3) infinite; }
        @keyframes dots { 0% { content: '.'; } 33% { content: '..'; } 66% { content: '...'; } }

        .toast {
            position: fixed; bottom: 30px; left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: #ef4444; color: #fff; padding: 12px 24px;
            border-radius: 14px; font-size: 14px; font-weight: 600;
            z-index: 100; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            white-space: nowrap;
        }
        .toast.show { transform: translateX(-50%) translateY(0); }

        .score-row {
            display: flex; align-items: center; gap: 12px;
            padding: 10px 0; border-bottom: 1px solid var(--border);
        }
        .score-row:last-child { border-bottom: none; }
        .score-row .rank { font-size: 18px; width: 28px; text-align: center; }
        .score-row .sname { flex: 1; font-weight: 600; }
        .score-row .spoints { font-size: 18px; font-weight: 800; color: var(--gold); }

        .scoreboard-title {
            font-size: 13px; font-weight: 600; color: var(--dim);
            text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;
        }

        .spacer { flex: 1; }
        .mt-8 { margin-top: 8px; }
        .mt-16 { margin-top: 16px; }
        .mb-16 { margin-bottom: 16px; }
        .text-dim { color: var(--dim); font-size: 14px; }

        /* Discussion tips */
        .discussion-tips {
            background: rgba(139,92,246,0.1);
            border: 1px solid rgba(139,92,246,0.2);
            border-radius: 14px;
            padding: 16px;
            margin-top: 12px;
        }
        .discussion-tips h3 {
            font-size: 14px; font-weight: 700; color: var(--purple);
            margin-bottom: 8px;
        }
        .discussion-tips p {
            font-size: 13px; color: var(--dim); line-height: 1.5;
        }

        /* Impostor reveal */
        .impostor-reveal {
            text-align: center;
            padding: 20px;
            background: rgba(239,68,68,0.1);
            border: 1px solid rgba(239,68,68,0.2);
            border-radius: 16px;
            margin-top: 12px;
        }
        .impostor-reveal .ir-name {
            font-size: 24px; font-weight: 900; color: var(--red);
        }
    </style>
</head>
<body>
    <div class="bg-glow"></div>
    <div class="app">
        <div class="top-bar" id="topBar" style="display:none">
            <a href="/" class="back">‹</a>
            <h1>🕵️ Impostor</h1>
            <div class="room-code" id="roomCodeDisplay">----</div>
        </div>

        <!-- ========== MENU ========== -->
        <div class="screen active" id="screenMenu">
            <div style="text-align:center; padding: 40px 0 24px;">
                <div style="font-size:72px; margin-bottom:16px;">🕵️</div>
                <h1 style="font-size:36px; font-weight:900; background: linear-gradient(135deg, #ef4444, #f97316); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">Impostor</h1>
                <p style="color:var(--dim); margin-top:8px; font-size:15px;">Descobre quem está a fingir!</p>
            </div>

            <div class="card">
                <div class="input-group">
                    <label>O teu nome</label>
                    <input type="text" id="inputName" placeholder="Escreve o teu nome..." maxlength="15" autocomplete="off">
                </div>
                <button class="btn btn-primary mb-16" onclick="createRoom()">Criar Sala</button>

                <div style="text-align:center; color:var(--dim); font-size:13px; margin-bottom:16px;">— ou —</div>

                <div class="input-group">
                    <label>Código da sala</label>
                    <input type="text" id="inputCode" placeholder="ABCD" maxlength="4" style="text-transform:uppercase; text-align:center; font-size:24px; letter-spacing:8px; font-weight:800;" autocomplete="off">
                </div>
                <button class="btn btn-ghost" onclick="joinRoom()">Entrar na Sala</button>
            </div>

            <div style="margin-top:auto; padding-top:24px;">
                <a href="/" class="btn btn-ghost" style="display:block;">← Voltar aos Jogos</a>
            </div>
        </div>

        <!-- ========== LOBBY ========== -->
        <div class="screen" id="screenLobby">
            <div class="card">
                <div style="text-align:center; margin-bottom:16px;">
                    <div style="font-size:13px; color:var(--dim); text-transform:uppercase; letter-spacing:0.5px;">Código da Sala</div>
                    <div style="font-size:36px; font-weight:900; letter-spacing:6px; color:var(--accent2);" id="lobbyCode">----</div>
                    <div style="font-size:12px; color:var(--dim); margin-top:4px;">Partilha este código com os teus amigos</div>
                </div>
            </div>

            <div class="card">
                <div style="font-size:13px; font-weight:600; color:var(--dim); text-transform:uppercase; margin-bottom:8px;">
                    Jogadores <span id="lobbyCount">(0)</span>
                </div>
                <ul class="players-list" id="lobbyPlayers"></ul>
            </div>

            <div class="spacer"></div>
            <div id="lobbyStartBtn"></div>
        </div>

        <!-- ========== SHOW ROLE ========== -->
        <div class="screen" id="screenShowRole">
            <div class="round-info">Ronda <strong id="showRoleRound">1</strong> de <strong id="showRoleMax">5</strong></div>
            <div class="card" id="showRoleContent"></div>
            <div id="showRoleAction"></div>
        </div>

        <!-- ========== DISCUSSION ========== -->
        <div class="screen" id="screenDiscussion">
            <div class="round-info">Ronda <strong id="discussionRound">1</strong> de <strong id="discussionMax">5</strong></div>
            <div class="timer-bar"><div class="fill" id="discussionTimer"></div></div>
            <div class="card" id="discussionContent"></div>
            <div id="discussionAction"></div>
        </div>

        <!-- ========== VOTING ========== -->
        <div class="screen" id="screenVoting">
            <div class="round-info">Ronda <strong id="votingRound">1</strong> de <strong id="votingMax">5</strong></div>
            <div class="timer-bar"><div class="fill" id="votingTimer"></div></div>
            <div class="card">
                <div style="text-align:center; margin-bottom:16px;">
                    <div style="font-size:36px; margin-bottom:8px;">🗳️</div>
                    <h2 style="font-size:20px; font-weight:800;">Quem é o Impostor?</h2>
                    <p class="text-dim mt-8">Votos: <strong id="voteProgress">0/0</strong></p>
                </div>
                <div class="vote-grid" id="voteGrid"></div>
            </div>
            <div id="votingAction" class="mt-16"></div>
        </div>

        <!-- ========== IMPOSTOR GUESS ========== -->
        <div class="screen" id="screenImpostorGuess">
            <div class="card" id="impostorGuessContent"></div>
            <div id="impostorGuessAction"></div>
        </div>

        <!-- ========== RESULT ========== -->
        <div class="screen" id="screenResult">
            <div class="card" id="resultContent"></div>
            <div class="card">
                <div class="scoreboard-title">Pontuação</div>
                <div id="resultScores"></div>
            </div>
            <div id="resultAction" class="mt-16"></div>
        </div>

        <!-- ========== GAME OVER ========== -->
        <div class="screen" id="screenGameover">
            <div style="text-align:center; padding:24px 0;">
                <div style="font-size:64px; margin-bottom:12px;">🏆</div>
                <h2 style="font-size:28px; font-weight:900; background: linear-gradient(135deg, #f9d423, #f59e0b); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">Fim do Jogo!</h2>
            </div>
            <div class="card">
                <div class="scoreboard-title">Classificação Final</div>
                <div id="gameoverScores"></div>
            </div>
            <div id="gameoverAction" class="mt-16"></div>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        let state = null;
        let selectedVote = null;

        socket.on('connect', () => console.log('Conectado'));
        socket.on('error_msg', msg => showToast(msg));
        socket.on('room_created', () => {});
        socket.on('room_joined', () => {});
        socket.on('state_update', newState => {
            state = newState;
            render();
        });

        function createRoom() {
            const name = document.getElementById('inputName').value.trim();
            if (!name) return showToast('Escreve o teu nome!');
            socket.emit('create_room', { game: 'impostor', playerName: name });
        }

        function joinRoom() {
            const name = document.getElementById('inputName').value.trim();
            const code = document.getElementById('inputCode').value.trim();
            if (!name) return showToast('Escreve o teu nome!');
            if (code.length !== 4) return showToast('Código deve ter 4 letras!');
            socket.emit('join_room', { code, playerName: name });
        }

        function showScreen(id) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            document.getElementById('topBar').style.display = state ? 'flex' : 'none';
        }

        function render() {
            if (!state) return showScreen('screenMenu');
            document.getElementById('roomCodeDisplay').textContent = state.code;

            switch (state.phase) {
                case 'lobby': renderLobby(); break;
                case 'show_role': renderShowRole(); break;
                case 'discussion': renderDiscussion(); break;
                case 'voting': renderVoting(); break;
                case 'impostor_guess': renderImpostorGuess(); break;
                case 'result': renderResult(); break;
                case 'gameover': renderGameover(); break;
            }
        }

        function renderLobby() {
            showScreen('screenLobby');
            document.getElementById('lobbyCode').textContent = state.code;
            document.getElementById('lobbyCount').textContent = `(${state.players.length})`;

            document.getElementById('lobbyPlayers').innerHTML = state.players.map(p => `
                <li>
                    <div class="avatar">${p.name[0].toUpperCase()}</div>
                    <span class="name">${esc(p.name)}</span>
                    ${p.isHost ? '<span class="host-badge">Anfitrião</span>' : ''}
                    ${p.id === state.myId ? '<span style="color:var(--accent2); font-size:12px;">Tu</span>' : ''}
                </li>
            `).join('');

            const btnDiv = document.getElementById('lobbyStartBtn');
            if (state.isHost) {
                btnDiv.innerHTML = `<button class="btn btn-primary" onclick="socket.emit('start_game')" ${state.players.length < 3 ? 'disabled' : ''}>
                    ${state.players.length < 3 ? `Precisas de ${3 - state.players.length} jogador(es) mais` : 'Começar Jogo'}
                </button>`;
            } else {
                btnDiv.innerHTML = '<div class="waiting">A aguardar que o anfitrião comece<span class="dots"></span></div>';
            }
        }

        function renderShowRole() {
            showScreen('screenShowRole');
            document.getElementById('showRoleRound').textContent = state.round;
            document.getElementById('showRoleMax').textContent = state.maxRounds;

            const content = document.getElementById('showRoleContent');
            const action = document.getElementById('showRoleAction');

            if (state.isImpostor) {
                content.innerHTML = `
                    <div class="role-reveal">
                        <div class="role-icon">🕵️</div>
                        <h2 class="impostor-text">Tu és o Impostor!</h2>
                        <div class="category">Categoria: <strong>${esc(state.category)}</strong></div>
                        <div class="secret-hidden">???</div>
                        <p class="text-dim mt-16">Não sabes a palavra! Finge que sabes e tenta não ser descoberto.</p>
                    </div>
                `;
            } else {
                content.innerHTML = `
                    <div class="role-reveal">
                        <div class="role-icon">😇</div>
                        <h2 class="citizen-text">Tu és Inocente!</h2>
                        <div class="category">Categoria: <strong>${esc(state.category)}</strong></div>
                        <div class="secret-word">${esc(state.word)}</div>
                        <p class="text-dim mt-16">Dá pistas subtis. Se fores muito óbvio, o impostor adivinha a palavra!</p>
                    </div>
                `;
            }

            action.innerHTML = `
                <button class="btn btn-primary" onclick="socket.emit('impostor_ready')">Estou Pronto!</button>
                <p class="text-dim text-center mt-8">${state.readyCount} de ${state.players.length} prontos</p>
            `;
        }

        function renderDiscussion() {
            showScreen('screenDiscussion');
            document.getElementById('discussionRound').textContent = state.round;
            document.getElementById('discussionMax').textContent = state.maxRounds;
            updateTimer('discussionTimer', state.timerEnd, 120000);

            const content = document.getElementById('discussionContent');

            let wordInfo = '';
            if (state.isImpostor) {
                wordInfo = `
                    <div style="background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.2); border-radius:12px; padding:12px; margin-bottom:16px; text-align:center;">
                        <span style="font-size:12px; color:var(--red); font-weight:600;">🕵️ TU ÉS O IMPOSTOR</span><br>
                        <span style="font-size:13px; color:var(--dim);">Categoria: <strong>${esc(state.category)}</strong></span>
                    </div>
                `;
            } else {
                wordInfo = `
                    <div style="background:rgba(34,197,94,0.1); border:1px solid rgba(34,197,94,0.2); border-radius:12px; padding:12px; margin-bottom:16px; text-align:center;">
                        <span style="font-size:12px; color:var(--green); font-weight:600;">😇 A TUA PALAVRA</span><br>
                        <span style="font-size:20px; font-weight:800; color:var(--gold);">${esc(state.word)}</span>
                    </div>
                `;
            }

            content.innerHTML = `
                ${wordInfo}
                <div style="text-align:center;">
                    <div style="font-size:48px; margin-bottom:12px;">💬</div>
                    <h2 style="font-size:20px; font-weight:800; margin-bottom:8px;">Discussão!</h2>
                    <p class="text-dim">Cada jogador dá uma pista sobre a sua palavra.<br>Atenção: o impostor está a ouvir!</p>
                </div>
                <div class="discussion-tips">
                    <h3>💡 Dicas</h3>
                    <p>• Cada um diz uma palavra/frase curta relacionada<br>
                       • Não sejam demasiado óbvios<br>
                       • Observem quem hesita ou dá respostas vagas</p>
                </div>
            `;

            const action = document.getElementById('discussionAction');
            if (state.isHost) {
                action.innerHTML = '<button class="btn btn-primary mt-16" onclick="socket.emit(\'impostor_start_vote\')">Começar Votação 🗳️</button>';
            } else {
                action.innerHTML = '<div class="waiting">O anfitrião avança quando quiser<span class="dots"></span></div>';
            }
        }

        function renderVoting() {
            showScreen('screenVoting');
            document.getElementById('votingRound').textContent = state.round;
            document.getElementById('votingMax').textContent = state.maxRounds;
            updateTimer('votingTimer', state.timerEnd, 30000);
            document.getElementById('voteProgress').textContent = `${state.voteCount}/${state.players.length}`;

            const grid = document.getElementById('voteGrid');

            if (state.myVote) {
                grid.innerHTML = state.players.map(p => `
                    <div class="vote-btn ${state.myVote === p.id ? 'selected' : ''}" style="cursor:default;">
                        <div class="vote-avatar">${p.name[0].toUpperCase()}</div>
                        <div class="vote-name">${esc(p.name)}</div>
                        ${state.myVote === p.id ? '<div style="color:var(--accent); font-size:12px; margin-top:4px;">Teu voto</div>' : ''}
                    </div>
                `).join('');
                document.getElementById('votingAction').innerHTML = '<div class="waiting">A aguardar outros votos<span class="dots"></span></div>';
            } else {
                grid.innerHTML = state.players.filter(p => p.id !== state.myId).map(p => `
                    <div class="vote-btn ${selectedVote === p.id ? 'selected' : ''}" onclick="selectVote('${p.id}')">
                        <div class="vote-avatar">${p.name[0].toUpperCase()}</div>
                        <div class="vote-name">${esc(p.name)}</div>
                    </div>
                `).join('');
                document.getElementById('votingAction').innerHTML = `
                    <button class="btn btn-primary mt-16" onclick="confirmVote()" ${!selectedVote ? 'disabled' : ''}>Confirmar Voto</button>
                `;
            }
        }

        function selectVote(id) {
            selectedVote = id;
            renderVoting();
        }

        function confirmVote() {
            if (!selectedVote) return showToast('Seleciona alguém!');
            socket.emit('impostor_vote', { votedFor: selectedVote });
            selectedVote = null;
        }

        function renderImpostorGuess() {
            showScreen('screenImpostorGuess');

            const content = document.getElementById('impostorGuessContent');
            const action = document.getElementById('impostorGuessAction');
            const impostor = state.players[state.impostorIndex];

            if (state.isImpostor) {
                content.innerHTML = `
                    <div style="text-align:center; padding:20px 0;">
                        <div style="font-size:48px; margin-bottom:12px;">😱</div>
                        <h2 style="font-size:20px; font-weight:800; color:var(--red); margin-bottom:8px;">Foste Apanhado!</h2>
                        <p class="text-dim">Mas ainda tens uma chance! Adivinha a palavra secreta para roubar a vitória.</p>
                        <p class="text-dim mt-8">Categoria: <strong style="color:var(--gold)">${esc(state.category)}</strong></p>
                    </div>
                `;
                action.innerHTML = `
                    <div class="input-group">
                        <label>Qual era a palavra?</label>
                        <input type="text" id="impostorGuessInput" placeholder="A tua resposta..." maxlength="40" autocomplete="off" onkeydown="if(event.key==='Enter')submitImpostorGuess()">
                    </div>
                    <button class="btn btn-primary" onclick="submitImpostorGuess()">Adivinhar!</button>
                `;
                setTimeout(() => { const el = document.getElementById('impostorGuessInput'); if (el) el.focus(); }, 100);
            } else {
                content.innerHTML = `
                    <div style="text-align:center; padding:20px 0;">
                        <div style="font-size:48px; margin-bottom:12px;">🎯</div>
                        <h2 style="font-size:20px; font-weight:800; margin-bottom:8px;">Impostor apanhado!</h2>
                        <div class="impostor-reveal">
                            <div style="font-size:12px; color:var(--dim);">O impostor era</div>
                            <div class="ir-name">${esc(impostor.name)}</div>
                        </div>
                        <p class="text-dim mt-16">Mas o impostor pode ainda tentar adivinhar a palavra para roubar a vitória!</p>
                    </div>
                `;
                action.innerHTML = '<div class="waiting">A aguardar a resposta do impostor<span class="dots"></span></div>';
            }
        }

        function submitImpostorGuess() {
            const input = document.getElementById('impostorGuessInput');
            if (!input) return;
            const guess = input.value.trim();
            if (!guess) return showToast('Escreve a tua resposta!');
            socket.emit('impostor_final_guess', { guess });
        }

        function renderResult() {
            showScreen('screenResult');

            const content = document.getElementById('resultContent');
            const impostor = state.players[state.impostorIndex];

            let resultHtml = '';

            if (state.impostorCaught) {
                if (state.guessCorrect) {
                    resultHtml = `
                        <div class="result-display">
                            <div class="emoji">🕵️</div>
                            <div class="msg" style="color:var(--red);">Impostor adivinha a palavra!</div>
                            <p class="text-dim mt-8">${esc(impostor.name)} foi apanhado mas adivinhou "<strong style="color:var(--gold)">${esc(state.guess)}</strong>"</p>
                        </div>
                    `;
                } else {
                    resultHtml = `
                        <div class="result-display">
                            <div class="emoji">🎉</div>
                            <div class="msg" style="color:var(--green);">Inocentes vencem!</div>
                            <p class="text-dim mt-8">${esc(impostor.name)} foi apanhado e errou: "${esc(state.guess)}"</p>
                        </div>
                    `;
                }
            } else {
                resultHtml = `
                    <div class="result-display">
                        <div class="emoji">🕵️</div>
                        <div class="msg" style="color:var(--red);">O Impostor escapa!</div>
                        <p class="text-dim mt-8">Ninguém conseguiu descobrir quem era o impostor.</p>
                    </div>
                `;
            }

            resultHtml += `
                <div class="impostor-reveal">
                    <div style="font-size:12px; color:var(--dim);">O impostor era</div>
                    <div class="ir-name">${esc(impostor.name)}</div>
                </div>
                <div class="big-word">
                    <div class="label">A palavra secreta</div>
                    <div class="word">${esc(state.word)}</div>
                </div>
            `;

            content.innerHTML = resultHtml;
            renderScores('resultScores');

            const action = document.getElementById('resultAction');
            if (state.isHost) {
                action.innerHTML = '<button class="btn btn-primary" onclick="socket.emit(\'impostor_next\')">Próxima Ronda →</button>';
            } else {
                action.innerHTML = '<div class="waiting">A aguardar o anfitrião<span class="dots"></span></div>';
            }
        }

        function renderGameover() {
            showScreen('screenGameover');
            renderScores('gameoverScores');

            const action = document.getElementById('gameoverAction');
            if (state.isHost) {
                action.innerHTML = `
                    <button class="btn btn-primary mb-16" onclick="socket.emit('new_game')">Jogar de Novo</button>
                    <a href="/" class="btn btn-ghost" style="display:block;">Voltar ao Menu</a>
                `;
            } else {
                action.innerHTML = '<div class="waiting">A aguardar o anfitrião<span class="dots"></span></div>';
            }
        }

        function renderScores(containerId) {
            const sorted = [...state.players].sort((a, b) => b.score - a.score);
            const medals = ['🥇', '🥈', '🥉'];
            document.getElementById(containerId).innerHTML = sorted.map((p, i) => `
                <div class="score-row">
                    <div class="rank">${medals[i] || (i + 1)}</div>
                    <div class="sname">${esc(p.name)} ${p.id === state.myId ? '<span style="color:var(--accent2); font-size:11px;">(tu)</span>' : ''}</div>
                    <div class="spoints">${p.score} pt</div>
                </div>
            `).join('');
        }

        // ==================== HELPERS ====================
        function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

        let timerInterval;
        function updateTimer(elementId, endTime, total) {
            if (timerInterval) clearInterval(timerInterval);
            const el = document.getElementById(elementId);
            if (!endTime) { el.style.width = '100%'; return; }
            function tick() {
                const remaining = Math.max(0, endTime - Date.now());
                el.style.width = (remaining / total * 100) + '%';
                if (remaining <= 0) clearInterval(timerInterval);
            }
            tick();
            timerInterval = setInterval(tick, 200);
        }

        function showToast(msg) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2500);
        }

        document.getElementById('inputName').value = localStorage.getItem('jogoNome') || '';
        document.getElementById('inputName').addEventListener('input', e => {
            localStorage.setItem('jogoNome', e.target.value);
        });

        const params = new URLSearchParams(location.search);
        if (params.get('sala')) {
            document.getElementById('inputCode').value = params.get('sala');
        }
    </script>
</body>
</html>
